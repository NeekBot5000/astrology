# Copy to .env and fill in. Never commit the real .env.

# Public address of the site (used for Stripe return links)
BASE_URL=http://localhost:8000
# Where orders and finished PDFs are stored
DATA_DIR=data

# AI writer (https://console.anthropic.com). Without it, paid orders fail politely.
ANTHROPIC_API_KEY=

# Payments (https://dashboard.stripe.com/test/apikeys). Leave empty for "reserve a copy" pre-order mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_CENTS=900
CURRENCY=usd

# Customer support address shown on the site
SUPPORT_EMAIL=support@example.com
# Days to keep finished books and birth details before erasing them
KEEP_DAYS=30

# Optional: path to a Chromium binary for PDF rendering (otherwise run `playwright install chromium`)
CHROMIUM_PATH=
# Long random string; the password for /admin/stats (any username)
ADMIN_TOKEN=
# Set to true to read and approve each book before the customer can download it (recommended for the first ~10 orders)
REVIEW_BOOKS=false

# Business details for the legal pages (Terms, Privacy, Legal notice). Until the first three are set,
# those pages show a "draft" banner. Ask a lawyer to review the pages before launch (see docs/legal/LEGAL_CHECKLIST.md).
LEGAL_NAME=
# One line, commas between parts, e.g. "Musterstrasse 1, 10115 Berlin, Germany"
LEGAL_ADDRESS=
# Country whose law governs the terms, e.g. Germany
LEGAL_COUNTRY=
# VAT or sales-tax ID, if you have one
VAT_ID=
# Date the terms take effect, e.g. 2026-11-02
LEGAL_EFFECTIVE_DATE=

# AI model that writes the books. Default claude-opus-5-5 (about $0.30-0.80 per book); claude-sonnet-5-5 costs about half.
WRITER_MODEL=
